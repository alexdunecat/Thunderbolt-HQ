<form class="tb-sheet {{cssClass}}" autocomplete="off">
  <header class="tb-head">
    <div class="tb-portrait-box">
      <img class="tb-portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" alt="">
      <div class="tb-insignia" data-insignia title="{{insigniaHint}}">{{#if system.insignia}}<img src="{{system.insignia}}" alt="">{{else}}<i class="fas fa-shield-halved"></i>{{/if}}</div>
    </div>
    <div class="tb-head-main">
      <div class="tb-kicker">Личное дело пилота · ВВС Юктобании</div>
      <input class="tb-name" type="text" name="name" value="{{actor.name}}" placeholder="Имя пилота">
      <div class="tb-head-row">
        <label>Позывной <input type="text" name="system.callsign" value="{{system.callsign}}"></label>
        <label>Звание <input type="text" name="system.rank" value="{{system.rank}}"></label>
        <label>Архетип
          <select name="system.archetype">{{selectOptions archOptions selected=system.archetype blank="— не выбран —"}}</select>
        </label>
      </div>
      <div class="tb-head-plane">
        {{#if plane}}<b>{{plane.name}}</b> · {{plane.cls}}{{#if plane.carrier}} · палубный{{/if}}{{else}}<span class="tb-muted">Самолёт не назначен: перетащите машину из компендиума «Ангар: самолёты».</span>{{/if}}
      </div>
    </div>
  </header>

  <nav class="tb-tabs" data-group="primary">
    <a class="item" data-tab="combat">Боевая карточка</a>
    <a class="item" data-tab="plane">Самолёт</a>
    <a class="item" data-tab="triggers">Триггеры</a>
    <a class="item" data-tab="ground">Даунтайм{{#if dt.alert}} <i class="fas fa-circle-exclamation tb-warn"></i>{{/if}}</a>
    <a class="item" data-tab="file">Личное дело</a>
    <a class="item" data-tab="notes">Заметки</a>
  </nav>

  <section class="tb-body">
    {{!-- ================= БОЕВАЯ КАРТОЧКА ================= --}}
    <div class="tab" data-group="primary" data-tab="combat">
      <div class="tb-grid2">
        <fieldset class="tb-box">
          <legend>Навыки <span class="tb-budget {{#if pointsOver}}over{{/if}}">{{system.pointsUsed}} из {{system.pointsBudget}}</span></legend>
          <ol class="tb-skills">
            {{#each skills as |sk|}}
            <li class="tb-skill {{#if sk.blocked}}blocked{{/if}}">
              <a class="tb-roll" data-roll-skill="{{sk.key}}" title="Проверка {{sk.label}}: d10 + {{sk.total}}"><i class="fas fa-dice-d10"></i></a>
              <span class="tb-skill-name"><b>{{sk.label}}</b> <small>{{sk.en}} · {{sk.hint}}</small></span>
              <input type="number" name="system.skills.{{sk.key}}" value="{{sk.value}}" min="0" max="10">
              <span class="tb-skill-total" title="с триггерами">{{#if sk.mod}}{{sk.total}}{{/if}}</span>
              <span class="tb-skill-flags">{{#if sk.perk3}}<em title="Perk на 3–4">P3</em>{{/if}}{{#if sk.comp2}}<em class="c" title="Complication на 1–2">C2</em>{{/if}}{{#if sk.blocked}}<em class="c">Grit</em>{{/if}}</span>
            </li>
            {{/each}}
          </ol>
          <div class="tb-row tb-small">
            <label>Доп. очки навыков <input type="number" name="system.bonusPoints" value="{{system.bonusPoints}}"></label>
            <span class="tb-muted">Старт 6, у новичка 3. +1 после каждого вылета.</span>
          </div>
        </fieldset>

        <fieldset class="tb-box tb-flight">
          <legend>В воздухе</legend>
          {{#each openClocks as |t|}}<div class="tb-threat tb-open-clock {{#if t.full}}full{{/if}}" title="{{t.note}}"><span class="tb-threat-name">{{#if t.alarm}}<i class="fas fa-bell"></i> {{/if}}{{t.name}}</span><span class="tb-clock">{{#each t.pips as |p|}}<i class="{{#if p.on}}on{{/if}}"></i>{{/each}}</span><span class="tb-num">{{t.value}}/{{t.size}}</span></div>{{/each}}
          {{#if acts}}<div class="tb-acts {{#if acts.over}}over{{/if}} {{#if acts.turn}}turn{{/if}}" title="{{acts.list}}">
            <i class="fas fa-list-check"></i> {{acts.label}}
            {{#if acts.canEnd}}<a class="tb-end-turn" data-end-turn title="{{#if acts.left}}Оставшиеся действия пропадают, ход переходит к следующему{{else}}Передать ход следующему{{/if}}"><i class="fas fa-forward-step"></i> {{#if acts.left}}Пропустить действия{{else}}Следующий ход{{/if}}</a>{{/if}}
          </div>{{/if}}
          <div class="tb-dials">
            <div class="tb-dial {{#if alertSpeed}}alert{{/if}}">
              <span class="tb-dial-label">Speed</span>
              <div class="tb-dial-row"><a data-speed="-1">−</a><input type="number" name="system.speed" value="{{system.speed}}"><a data-speed="1">+</a></div>
              <span class="tb-dial-sub">макс. {{maxSpeedNow}}</span>
            </div>
            <div class="tb-dial">
              <span class="tb-dial-label">Defense</span>
              <div class="tb-dial-big" {{#if defenseWeather}}title="с погодой"{{/if}}>{{defenseNow}}</div>
              <span class="tb-dial-sub">Evasion {{system.evasion}}{{#if system.breakEv}} · Break {{system.breakEv}} <a data-act="unbreak" title="Сбросить Break!">×</a>{{/if}} + Speed</span>
            </div>
            <div class="tb-dial">
              <span class="tb-dial-label">HP</span>
              <div class="tb-dial-row"><a data-step="system.hp.value" data-delta="-1">−</a><input type="number" name="system.hp.value" value="{{system.hp.value}}"><a data-step="system.hp.value" data-delta="1" data-max="{{system.hp.max}}">+</a></div>
              <span class="tb-dial-sub">из {{system.hp.max}}</span>
            </div>
            <div class="tb-dial">
              <span class="tb-dial-label">Strain</span>
              <div class="tb-dial-row"><a data-step="system.strain.value" data-delta="-1">−</a><input type="number" name="system.strain.value" value="{{system.strain.value}}"><a data-step="system.strain.value" data-delta="1" data-max="{{system.strain.max}}">+</a></div>
              <span class="tb-dial-sub">из {{system.strain.max}}</span>
            </div>
          </div>
          <div class="tb-row">
            <label>Высота <select name="system.alt">{{selectOptions altOptions selected=system.alt}}</select></label>
            <label class="tb-check"><input type="checkbox" name="system.twist" {{checked system.twist}}> Поворот был</label>
          </div>
          {{#if weather.length}}<div class="tb-weather tb-small">{{#each weather as |w|}}<span title="{{w.txt}}">{{w.ico}} {{w.name}}</span>{{/each}}</div>{{/if}}
          <div class="tb-row tb-small">
            <span>Air-Air <b>{{system.aa}}</b></span><span>Air-Gnd <b>{{system.ag}}</b></span><span>Gun DMG <b>{{system.gun}}</b></span>
          </div>
        </fieldset>
      </div>

      <div class="tb-lock-strip {{#if lockInfo}}on{{/if}}"><i class="fas fa-crosshairs"></i> Захват: {{#if lockInfo}}<a data-act="lock-focus" title="Показать цель на сцене"><b>{{lockInfo.name}}</b></a>{{#if lockInfo.dist}} <span class="tb-muted">({{lockInfo.dist}})</span>{{/if}}{{#if lockInfo.gone}} <span class="tb-warn">цели нет на сцене</span>{{/if}} <a data-act="lock" class="tb-lock-change" title="Навестись на другую цель: это действие Lock On!"><i class="fas fa-arrows-rotate"></i> сменить</a> <a data-act="unlock" title="Снять захват"><i class="fas fa-xmark"></i> снять</a>{{else}}<span class="tb-muted">нет</span>{{/if}}</div>
      <div class="tb-actions-bar">
        <button type="button" data-act="lock"><i class="fas fa-crosshairs"></i> Lock On!</button>
        <button type="button" data-act="missile"><i class="fas fa-rocket"></i> Fox Two! <span class="tb-dice-tag half" title="Без броска. С броском только Improved Fox Two!"><i class="fas fa-dice-d10"></i>?</span></button>
        <button type="button" data-act="guns"><i class="fas fa-burst"></i> Guns, Guns, Guns! <span class="tb-dice-tag" title="С броском d10 + d4: одна проверка за ход"><i class="fas fa-dice-d10"></i></span></button>
        <button type="button" data-act="break"><i class="fas fa-shuffle"></i> Break! <span class="tb-dice-tag" title="С броском d10 + d4: одна проверка за ход"><i class="fas fa-dice-d10"></i></span></button>
        <button type="button" data-act="recover"><i class="fas fa-bolt"></i> Вернуть Strain <span class="tb-dice-tag" title="С броском d10 + d4: одна проверка за ход"><i class="fas fa-dice-d10"></i></span></button>
        <button type="button" data-act="stall"><i class="fas fa-arrow-down"></i> Сваливание <span class="tb-dice-tag" title="Бросок Push против 7 в начале хода при Speed 0 и ниже"><i class="fas fa-dice-d10"></i></span></button>
        <button type="button" data-act="lead"><i class="fas fa-bullhorn"></i> Leadership</button>
        <button type="button" data-act="formup"><i class="fas fa-people-arrows"></i> Вплотную</button>
      </div>
      <p class="tb-small tb-muted tb-dice-legend"><i class="fas fa-dice-d10"></i> — действие с броском (за ход одна проверка). <i class="fas fa-dice-d10"></i>? — бросок по желанию (Improved). Без значка — без броска: Lock On!, Leadership, Вплотную, пуск ЗРК, Move, Climb / Dive, Change Speed.</p>
      {{#if nextMods.length}}<p class="tb-fx-now tb-small"><span class="tb-muted">К следующему броску:</span> {{#each nextMods as |m|}}<span class="tb-chip">{{m.sval}} {{m.label}} <a data-next-drop="{{m.i}}" title="Убрать">×</a></span>{{/each}}</p>{{/if}}
      {{#if dt.sortie}}<div class="tb-dt-strip tb-small">
        {{#if dt.edgeFly}}<span class="tb-chip tb-edge-fly" title="Complication на 1–2 во всех проверках, срыв при первой d4 = 1 или метке урона">на пределе</span>{{/if}}
        {{#if dt.breakdown}}<span class="tb-chip tb-edge-fly" title="{{dt.breakdown.text}}">Срыв: {{dt.breakdown.label}}</span>{{/if}}
        {{#each dt.bondChips as |b|}}<a class="tb-chip tb-dt-use {{#if b.used}}used{{/if}}" {{#unless b.used}}data-bond-use="{{b.i}}"{{/unless}} title="{{#if b.used}}В этом вылете уже прибавлена{{else}}Раз за вылет: к броску, который помогает этому товарищу или защищает его{{/if}}"><i class="fas fa-link"></i> Связь: {{b.name}} +{{b.value}}</a>{{/each}}
        {{#each dt.edgeChips as |e|}}<a class="tb-chip tb-dt-use {{#if e.used}}used{{/if}}" {{#unless e.used}}data-edge-use="{{e.id}}"{{/unless}} title="{{e.hint}}"><i class="fas fa-bookmark"></i> {{e.label}}</a>{{/each}}
        {{#each dt.passive as |e|}}<span class="tb-chip" title="Задел на этот вылет">{{e}}</span>{{/each}}
      </div>{{/if}}
      {{#if adjacent.length}}<p class="tb-fx-now tb-small"><span class="tb-muted">Вплотную с:</span> {{#each adjacent as |x|}}<span class="tb-chip">{{x.name}} <a data-adj-drop="{{x.uuid}}" title="Отрыв">×</a></span>{{/each}}</p>{{/if}}

      {{#if situational.length}}
      <div class="tb-fx-bar">
        <span class="tb-fx-title">Ситуативные триггеры</span>
        {{#each situational as |t|}}
          {{#if t.hasToggle}}<a class="tb-fx-toggle {{#if t.active}}on{{/if}}" data-trigger-active="{{t.id}}" title="{{t.fxText}}"><i class="fas {{#if t.active}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i> {{t.name}} <small>{{t.toggleHint}}</small></a>{{/if}}
          {{#if t.hasStack}}<span class="tb-fx-toggle {{#if t.stack}}on{{/if}}" title="{{t.fxText}}">{{t.name}} <a data-trigger-stack="{{t.id}}" data-delta="-1">−</a><b>{{t.stack}}</b><a data-trigger-stack="{{t.id}}" data-delta="1">+</a></span>{{/if}}
        {{/each}}
      </div>
      {{/if}}
      {{#if activeFx.length}}
      <p class="tb-fx-now tb-small"><span class="tb-muted">Сейчас действуют:</span> {{#each activeFx as |m|}}<span class="tb-chip" title="{{m.name}}">{{m.label}} {{m.sval}} <small>{{m.name}}</small></span>{{/each}}</p>
      {{/if}}

      <div class="tb-grid2">
        <fieldset class="tb-box tb-markers">
          <legend>Метки урона <span class="tb-muted">не больше одной за раунд</span></legend>
          <div class="tb-marker {{#if system.markers.grit}}on{{/if}}">
            <label class="tb-check"><input type="checkbox" name="system.markers.grit" {{checked system.markers.grit}}> <b>Grit</b></label>
            <select name="system.markers.gritSkill">{{selectOptions skillOptions selected=system.markers.gritSkill blank="навык…"}}</select>
          </div>
          <div class="tb-marker {{#if system.markers.structure}}on{{/if}}">
            <label class="tb-check"><input type="checkbox" name="system.markers.structure" {{checked system.markers.structure}}> <b>Structure</b></label>
            <select name="system.markers.sys">{{selectOptions sysOptions selected=system.markers.sys blank="система…"}}</select>
          </div>
          <div class="tb-marker doom {{#if system.markers.doom}}on{{/if}}">
            <label class="tb-check"><input type="checkbox" name="system.markers.doom" {{checked system.markers.doom}}> <b>Doom</b></label>
            <span class="tb-muted">бросок на катапультирование</span>
          </div>
          <button type="button" class="tb-wide" data-act="sortie"><i class="fas fa-plane-departure"></i> Перед вылетом: всё до максимума</button>
        </fieldset>

        <fieldset class="tb-box">
          <legend>Спецоружие {{#if plane}}<span class="tb-budget {{#if weaponsOver}}over{{/if}}">{{weapons.length}} из {{system.hardpoints}} узлов</span>{{/if}}</legend>
          {{#if weapons.length}}
          <ul class="tb-list">
            {{#each weapons as |w|}}
            <li class="tb-item" data-item-id="{{w.id}}">
              <span class="tb-item-name"><a data-chat-item="{{w.id}}" title="В чат">{{w.name}}</a><small>{{#if w.target}}{{w.target}} · {{/if}}урон {{w.dmg}} · <i class="fas fa-ruler-horizontal"></i> {{w.range}}{{#if w.mods}} · {{w.mods}}{{/if}}</small></span>
              {{#if w.unlimited}}<span class="tb-ammo">∞</span>{{else}}
              <span class="tb-ammo" {{#if w.bonus}}title="+{{w.bonus}} от триггера"{{/if}}><a data-ammo="{{w.id}}" data-delta="-1">−</a>{{w.ammo}}/{{w.max}}<a data-ammo="{{w.id}}" data-delta="1">+</a></span>{{/if}}
              <a class="tb-icon tb-aim{{#if w.aimed}} on{{/if}}" data-aim="{{w.id}}" title="{{#if w.aimed}}Подсветка дальности по этому оружию. Щелчок: обратно стандартная ракета{{else}}Подсвечивать дальность этого оружия у выделенного самолёта{{/if}}"><i class="fas fa-crosshairs"></i></a>
              <a class="tb-icon" data-item-edit="{{w.id}}" title="Открыть"><i class="fas fa-pen"></i></a>
              <a class="tb-icon" data-item-delete="{{w.id}}" title="Убрать"><i class="fas fa-trash"></i></a>
            </li>
            {{/each}}
          </ul>
          {{else}}<p class="tb-muted">Перетащите спецоружие из компендиума. Узлов подвески: {{system.hardpoints}}.</p>{{/if}}
          {{#if plane.sigNames}}<p class="tb-small tb-muted">Штатное для этой машины: {{plane.sigNames}}.</p>{{/if}}
        </fieldset>
      </div>
    </div>

    {{!-- ================= САМОЛЁТ ================= --}}
    <div class="tab" data-group="primary" data-tab="plane">
      {{#if plane}}
      <div class="tb-plane">
        <img class="tb-plane-img" src="{{plane.img}}" alt="">
        <div>
          <h2>{{plane.name}} <small>{{plane.nato}}</small></h2>
          <p class="tb-muted">{{plane.cls}}{{#if plane.tierName}} · {{plane.tierName}}{{/if}} · шаблон {{plane.base}}{{#if plane.est}} · оценка{{/if}}</p>
          <table class="tb-stats"><tr>{{#each plane.statRows as |r|}}<th title="{{r.ru}}">{{r.en}}</th>{{/each}}</tr>
            <tr>{{#each plane.statRows as |r|}}<td>{{r.value}}</td>{{/each}}</tr></table>
          <div class="tb-row">
            <a class="tb-btn" data-item-edit="{{plane.id}}"><i class="fas fa-pen"></i> Открыть карточку</a>
            <a class="tb-btn" data-item-delete="{{plane.id}}"><i class="fas fa-trash"></i> Снять машину</a>
          </div>
        </div>
      </div>
      {{#if plane.props.length}}<h3>Особенности</h3>
      <ul class="tb-props">{{#each plane.props as |p|}}<li><b>{{p.name}}.</b> {{p.text}}</li>{{/each}}</ul>{{/if}}
      {{#if plane.desc}}<p>{{plane.desc}}</p>{{/if}}
      {{#if plane.service}}<p class="tb-muted">{{plane.service}}</p>{{/if}}
      <div class="tb-row"><label>WSO во второй кабине <input type="text" name="system.wso" value="{{system.wso}}" placeholder="имя игрока-штурмана"></label></div>
      {{else}}
      <p class="tb-empty">Самолёт не назначен. Откройте компендиум «Ангар: самолёты» и перетащите машину на этот лист. Новая машина заменит старую.</p>
      {{/if}}
    </div>

    {{!-- ================= ТРИГГЕРЫ ================= --}}
    <div class="tab" data-group="primary" data-tab="triggers">
      {{#if triggers.length}}
      <ul class="tb-triggers">
        {{#each triggers as |t|}}
        <li class="tb-item tb-trigger {{#if t.used}}used{{/if}}" data-item-id="{{t.id}}">
          <div class="tb-trigger-head">
            <a data-chat-item="{{t.id}}" title="В чат"><b>{{t.name}}</b></a> <small>{{t.en}}</small>
            <span class="tb-tags">{{t.typeText}}</span>
            <label class="tb-check" title="Использован в этом вылете"><input type="checkbox" data-item-toggle="{{t.id}}" {{checked t.used}}> исп.</label>
            <a class="tb-icon" data-item-edit="{{t.id}}"><i class="fas fa-pen"></i></a>
            <a class="tb-icon" data-item-delete="{{t.id}}"><i class="fas fa-trash"></i></a>
          </div>
          <p>{{t.text}}</p>
          {{#if t.fxText}}<p class="tb-fx-line"><i class="fas fa-gears"></i> {{t.fxText}}</p>{{/if}}
          {{#if t.hasOpts}}<div class="tb-row tb-small">
            {{#if t.needsSkill}}<label>Навык <select data-item-id="{{t.id}}" data-item-field="system.skill">{{selectOptions @root.skillOptions selected=t.skill blank="—"}}</select></label>{{/if}}
            {{#if t.needsTwo}}<label>Второй <select data-item-id="{{t.id}}" data-item-field="system.skill2">{{selectOptions @root.skillOptions selected=t.skill2 blank="—"}}</select></label>{{/if}}
            {{#if t.needsWeapon}}<label>Спецоружие <select data-item-id="{{t.id}}" data-item-field="system.weapon">{{selectOptions @root.weaponOpts selected=t.weapon blank="выберите…"}}</select></label>{{/if}}
            {{#if t.hasToggle}}<a class="tb-fx-toggle {{#if t.active}}on{{/if}}" data-trigger-active="{{t.id}}"><i class="fas {{#if t.active}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i> {{#if t.active}}включён{{else}}выключен{{/if}}</a>{{/if}}
            {{#if t.hasStack}}<span class="tb-fx-toggle {{#if t.stack}}on{{/if}}">серия <a data-trigger-stack="{{t.id}}" data-delta="-1">−</a><b>{{t.stack}}</b><a data-trigger-stack="{{t.id}}" data-delta="1">+</a></span>{{/if}}
          </div>{{/if}}
        </li>
        {{/each}}
      </ul>
      {{else}}<p class="tb-empty">Перетащите триггеры из компендиума «Триггеры». Core-триггер архетипа берётся при создании пилота.</p>{{/if}}
    </div>

    {{!-- ================= ДАУНТАЙМ ================= --}}
    <div class="tab tb-ground" data-group="primary" data-tab="ground">
      <div class="tb-grid2">
        <fieldset class="tb-box">
          <legend>Нервы <span class="tb-muted">0–5</span></legend>
          <div class="tb-pips tb-nerves">{{#each dt.nervesPips as |p|}}<a class="tb-pip {{#if p.on}}on{{/if}} {{p.cls}}" data-nerves="{{p.i}}" title="Нервы {{p.i}}">{{p.i}}</a>{{/each}}</div>
          <p class="tb-small {{#if dt.nervesWarn}}tb-warn{{else}}tb-muted{{/if}}">{{dt.nervesNote}}</p>
          {{#if dt.edgeAsk}}<div class="tb-row tb-edge-ask"><button type="button" data-edge-choice="fly" title="Strain −2, Complication на 1–2 во всех проверках, раз за вылет срыв"><i class="fas fa-jet-fighter"></i> Лететь на пределе</button><button type="button" data-edge-choice="rest" title="Пропустить вылет, Нервы 0"><i class="fas fa-bed"></i> Рапорт об отдыхе</button></div>{{/if}}
          {{#if dt.edgeFly}}<p class="tb-small tb-warn"><b>Летит на пределе:</b> Strain −2, Complication на 1–2 во всех проверках (со страхом 1–3), Нервы больше не растут. Раз за вылет срыв.</p>{{/if}}
          <p class="tb-small"><a class="tb-btn {{#if system.downtime.nervesDown}}disabled{{/if}}" data-vent title="Пилот всерьёз выговорился в общей сцене: −1 Нервы, раз за даунтайм"><i class="fas fa-comments"></i> Выговорился: −1</a></p>
        </fieldset>
        <fieldset class="tb-box">
          <legend>Решимость и действия</legend>
          <div class="tb-row"><span>Решимость</span> <span class="tb-pips">{{#each dt.resolvePips as |p|}}<a class="tb-pip {{#if p.on}}on{{/if}}" data-resolve="{{p.i}}">◆</a>{{/each}}</span>
            <small class="tb-muted">досье изменилось: +1, не больше 1 за даунтайм; тратится кнопкой на карточке: d4 = 4</small></div>
          {{#if dt.fee}}<div class="tb-row"><span>Гонорар</span> <span class="tb-pips">{{#each dt.fee as |p|}}<a class="tb-pip {{#if p.on}}on{{/if}}" data-fee="{{p.i}}">₽</a>{{/each}}</span>
            <small class="tb-muted">Контракт: +1 за сбитого Duelist или Ace, +1 за задачу, не больше 2 за вылет; 1 Гонорар = Задел без броска</small></div>{{/if}}
          <div class="tb-row"><span>Действия даунтайма</span> <span class="tb-pips">{{#each dt.actionPips as |p|}}<a class="tb-pip {{#if p.on}}on{{/if}}" data-dt-actions="{{p.i}}">●</a>{{/each}}</span> <small class="tb-muted">осталось {{system.downtime.actions}} из 2; в госпитале и после цены «Время» одно</small></div>
          <div class="tb-dt-actions">
            {{#each dt.actions as |x|}}<button type="button" data-dt-action="{{x.key}}" title="{{x.hint}}" {{#if x.off}}disabled{{/if}}>{{#if x.roll}}<i class="fas fa-dice-d10"></i> {{/if}}{{x.label}}</button>{{/each}}
          </div>
          <button type="button" class="tb-wide" data-ground><i class="fas fa-dice-d10"></i> Проверка на земле без действия</button>
        </fieldset>
      </div>

      <fieldset class="tb-box tb-glory-sheet">
        <legend>Слава эскадрильи <span class="tb-budget">{{glory.points}}</span> <span class="tb-muted">{{#if glory.next}}до «{{glory.next}}» {{glory.toNext}}{{else}}высший уровень{{/if}}</span></legend>
        <p><b class="tb-glory-level lv-{{glory.key}}">{{glory.name}}</b>{{#if glory.nickname}} · враг зовёт вас <b>«{{glory.nickname}}»</b>{{/if}}. <span class="tb-muted">{{glory.mean}}.</span></p>
        {{#if glory.effects.length}}<ul class="tb-list tb-small">{{#each glory.effects as |e|}}<li><b>{{e.title}}</b> {{e.text}}</li>{{/each}}</ul>{{/if}}
      </fieldset>

      <fieldset class="tb-box">
        <legend>Заделы на следующий вылет <span class="tb-budget {{#if dt.edgesOver}}over{{/if}}">{{system.edgeCount}} из {{dt.maxEdges}}</span> <span class="tb-muted">сгорают после вылета</span></legend>
        {{#if dt.edges.length}}
        <ul class="tb-list tb-edges">
          {{#each dt.edges as |e|}}
          <li class="tb-item {{#if e.used}}used{{/if}} {{#if e.notEdge}}tb-edge-cost{{/if}}">
            <span class="tb-item-name"><b>{{e.label}}</b>{{#if e.comp}} <small class="tb-warn">Компромисс</small>{{/if}}{{#if e.used}} <small class="tb-muted">использован</small>{{/if}}<small>{{e.hint}}</small></span>
            {{#if e.needsMinus}}<label class="tb-small">встречная цена <select data-edge-field="minus" data-edge-id="{{e.id}}">{{selectOptions @root.dt.minusOptions selected=e.minus blank="нет"}}</select></label>{{/if}}
            {{#if e.isAmmo}}<label class="tb-small"><select data-edge-field="weapon" data-edge-id="{{e.id}}">{{selectOptions @root.weaponOpts selected=e.weapon blank="спецоружие…"}}</select></label>{{/if}}
            <a class="tb-icon" data-edge-del="{{e.id}}" title="Убрать"><i class="fas fa-trash"></i></a>
          </li>
          {{/each}}
        </ul>
        {{else}}<p class="tb-muted tb-small">Пока пусто. Успешное действие даунтайма даёт Задел кнопкой на карточке броска.</p>{{/if}}
        <a class="tb-btn" data-edge-add><i class="fas fa-plus"></i> Записать вручную</a>
      </fieldset>

      <div class="tb-grid2">
        <fieldset class="tb-box">
          <legend>Связи <span class="tb-muted">0–3, с NPC до 2</span></legend>
          {{#if dt.bonds.length}}
          <ul class="tb-list tb-bonds">
            {{#each dt.bonds as |b|}}
            <li class="tb-item {{#if b.dead}}dead{{/if}}">
              <span class="tb-item-name"><b>{{b.name}}</b>{{#if b.npc}} <small>NPC</small>{{/if}}{{#if b.dead}} <small class="tb-warn">погиб</small>{{/if}}</span>
              {{#if b.was}}<s class="tb-muted" title="прежние значения">{{b.was}}</s>{{/if}}
              <span class="tb-pips">{{#each b.pips as |p|}}<a class="tb-pip {{#if p.on}}on{{/if}}" data-bond-set="{{b.i}}" data-v="{{p.i}}">{{p.i}}</a>{{/each}}</span>
              <a class="tb-icon" data-bond-del="{{b.i}}" title="Убрать"><i class="fas fa-trash"></i></a>
            </li>
            {{/each}}
          </ul>
          {{else}}<p class="tb-muted tb-small">При создании пилот может назвать одного знакомого товарища: Связь 1. Растёт в сценах, где пилоты всерьёз ответили друг другу на крючок.</p>{{/if}}
          <a class="tb-btn" data-bond-add><i class="fas fa-plus"></i> Связь</a>
        </fieldset>
        <fieldset class="tb-box">
          <legend>Личные цели</legend>
          {{#if dt.goals.length}}
          <ul class="tb-list tb-goals">
            {{#each dt.goals as |g|}}
            <li class="tb-item {{#if g.done}}done{{/if}}">
              <input type="text" data-goal-field="name" data-goal="{{g.i}}" value="{{g.name}}" placeholder="найти пропавшего брата">
              <select data-goal-field="size" data-goal="{{g.i}}"><option value="4" {{#if g.small}}selected{{/if}}>4</option><option value="6" {{#unless g.small}}selected{{/unless}}>6</option></select>
              <span class="tb-clock">{{#each g.pips as |p|}}<i class="{{#if p.on}}on{{/if}}" data-goal-set="{{g.i}}" data-v="{{p.i}}"></i>{{/each}}</span>
              <a class="tb-icon" data-goal-del="{{g.i}}" title="Убрать"><i class="fas fa-trash"></i></a>
            </li>
            {{/each}}
          </ul>
          {{/if}}
          <a class="tb-btn" data-goal-add><i class="fas fa-plus"></i> Цель</a>
          <p class="tb-small tb-muted">4 деления для обычной цели, 6 для большой. Действие «Личное дело»: 7+ даёт +2, 4–6 даёт +1. Полная шкала: строка в досье и Решимость.</p>
          <h4>Долги</h4>
          {{#if dt.debts.length}}<ul class="tb-list tb-debts">{{#each dt.debts as |d|}}<li class="{{#if d.struck}}struck{{/if}}">{{d.text}} <a class="tb-icon" data-debt-strike="{{d.i}}" title="{{#if d.struck}}Вернуть{{else}}Расплатился{{/if}}"><i class="fas fa-strikethrough"></i></a></li>{{/each}}</ul>{{else}}<p class="tb-muted tb-small">Нет.</p>{{/if}}
          <a class="tb-btn" data-debt-add><i class="fas fa-plus"></i> Долг</a>
        </fieldset>
      </div>

      <fieldset class="tb-box">
        <legend>Шкалы угроз <span class="tb-muted">над эскадрильей, их ведёт AWACS</span></legend>
        {{#if dt.threats.length}}
        <div class="tb-threats">{{#each dt.threats as |t|}}<div class="tb-threat {{#if t.full}}full{{/if}}" title="{{t.note}}"><span class="tb-threat-name">{{t.name}}</span><span class="tb-clock">{{#each t.pips as |p|}}<i class="{{#if p.on}}on{{/if}}"></i>{{/each}}</span><span class="tb-num">{{t.value}}/{{t.size}}</span>{{#if @root.isGM}} <a data-threat-step="{{t.id}}" data-delta="-1">−</a> <a data-threat-step="{{t.id}}" data-delta="1">+</a>{{/if}}</div>{{/each}}</div>
        {{else}}<p class="tb-muted tb-small">Угроз пока нет.</p>{{/if}}
      </fieldset>
    </div>

    {{!-- ================= ЛИЧНОЕ ДЕЛО ================= --}}
    <div class="tab" data-group="primary" data-tab="file">
      <div class="tb-grid3">
        <label>Фамилия <input type="text" name="system.lastName" value="{{system.lastName}}"></label>
        <label>Имя <input type="text" name="system.firstName" value="{{system.firstName}}"></label>
        <label>Отчество <input type="text" name="system.patronymic" value="{{system.patronymic}}"></label>
        <label>Звено <input type="text" name="system.flight" value="{{system.flight}}"></label>
        <label>Эскадрилья <input type="text" name="system.squadron" value="{{system.squadron}}"></label>
        <label>База <input type="text" name="system.base" value="{{system.base}}"></label>
        <label>Год рождения <input type="text" name="system.birth" value="{{system.birth}}"></label>
        <label>Состояние <select name="system.service.status">{{selectOptions statusOptions selected=system.service.status}}</select></label>
      </div>
      <h3>Вопросы при зачислении</h3>
      <label class="tb-q">Почему этот позывной тебе подходит? <textarea name="system.questions.callsign" rows="2">{{system.questions.callsign}}</textarea></label>
      <label class="tb-q">В чём ты силён на земле? <textarea name="system.questions.ground" rows="2">{{system.questions.ground}}</textarea></label>
      <label class="tb-q">Чего ты боишься? <textarea name="system.questions.fear" rows="2">{{system.questions.fear}}</textarea></label>
      <label class="tb-q">Что заставит тебя ослушаться начальства? <textarea name="system.questions.defy" rows="2">{{system.questions.defy}}</textarea></label>
      <h3>Досье <small class="tb-muted">старое зачёркивается, не стирается</small></h3>
      <ol class="tb-dossier">
        {{#each dossier as |d|}}
        <li class="{{#if d.struck}}struck{{/if}}">
          <input type="text" data-dossier="{{d.i}}" value="{{d.text}}">
          <a class="tb-icon" data-dossier-strike="{{d.i}}" title="{{#if d.struck}}Вернуть{{else}}Зачеркнуть{{/if}}"><i class="fas fa-strikethrough"></i></a>
        </li>
        {{/each}}
      </ol>
      <a class="tb-btn" data-dossier-add><i class="fas fa-plus"></i> Новая запись</a>
      <h3>Послужной список</h3>
      <div class="tb-grid3">
        <label>Вылетов <input type="number" name="system.service.sorties" value="{{system.service.sorties}}"></label>
        <label>Операций <input type="number" name="system.service.ops" value="{{system.service.ops}}"></label>
        <label>Воздушных побед <input type="number" name="system.service.air" value="{{system.service.air}}"></label>
        <label>Наземных целей <input type="number" name="system.service.ground" value="{{system.service.ground}}"></label>
        <label>Катапультирований <input type="number" name="system.service.eject" value="{{system.service.eject}}"></label>
      </div>
      <h3>Операции <small class="tb-muted">пишутся сами из «Итогов вылета»</small></h3>
      {{#if serviceLog.length}}
      <table class="tb-oplog">
        <tr><th>№</th><th>Операция</th><th>Дата</th><th>Сбито</th><th>На земле</th><th></th></tr>
        {{#each serviceLog as |x|}}
        <tr><td>{{x.n}}</td><td><b>{{x.op}}</b>{{#if x.eject}} <span class="tb-warn" title="Катапультировался">⏏</span>{{/if}}</td><td>{{x.date}}</td><td>{{x.air}}</td><td>{{x.ground}}</td>
          <td>{{#if @root.isGM}}<a class="tb-icon" data-oplog-del="{{x.i}}" title="Убрать запись"><i class="fas fa-trash"></i></a>{{/if}}</td></tr>
        {{/each}}
      </table>
      {{else}}<p class="tb-muted tb-small">Пока ни одной операции.</p>{{/if}}
      <label class="tb-q">Награды <textarea name="system.service.awards" rows="2">{{system.service.awards}}</textarea></label>
    </div>

    {{!-- ================= ЗАМЕТКИ ================= --}}
    <div class="tab" data-group="primary" data-tab="notes">
      {{editor enrichedNotes target="system.notes" button=true editable=editable engine="prosemirror"}}
    </div>
  </section>
</form>
